# PHC bridge configuration. Copy to /etc/phc-bridge/bridge.env and edit.
# These addresses are EXAMPLES — never commit your real STM or Pi address.

# STM control unit (host or host:port; default port 6680).
PHC_STM_ADDRESS=192.168.1.50:6680

# Address the website listens on: the Pi's reserved LAN IP, or 0.0.0.0:8080 to
# accept the LAN interface regardless of IP (the firewall is the real boundary).
# Never 631 (CUPS); leave 80/443 free unless you bind port 80 (see below).
PHC_LISTEN_ADDRESS=0.0.0.0:8080

# The exact origin browsers use — enforced as Host/Origin and saved by the iOS
# Home Screen entry, so it must match the opened URL EXACTLY, port included.
# A router-provided hostname is ideal (stable across IP changes): a FRITZ!Box
# serves the Pi as http://raspberrypi, so with the 8080 listener above use:
#   PHC_PUBLIC_ORIGIN=http://raspberrypi:8080   (and always open that exact URL)
# Pick one canonical name — "raspberrypi" and "raspberrypi.fritz.box" are
# different origins. For a port-less http://raspberrypi, bind port 80 instead
# (PHC_LISTEN_ADDRESS=0.0.0.0:80) and grant the unit CAP_NET_BIND_SERVICE.
PHC_PUBLIC_ORIGIN=http://raspberrypi:8080

# Project cache — instant, STM-independent startup. Directory matches the unit's
# StateDirectory. Set PHC_PROJECT_CACHE=false to disable persistence.
PHC_STATE_DIR=/var/lib/phc-bridge
PHC_PROJECT_CACHE=true

# State polling cadence and the grace period after the last browser disconnects.
PHC_ACTIVE_POLL_INTERVAL=2.5s
PHC_SUBSCRIBER_GRACE_PERIOD=15s

# Optional: probe the STM this often while no browser is connected, so
# connection status stays fresh for health checks. 0 disables it (keeps the STM
# idle when nobody is watching).
PHC_IDLE_HEALTH_INTERVAL=0

# Log level: debug, info, warn, error.
PHC_LOG_LEVEL=info
